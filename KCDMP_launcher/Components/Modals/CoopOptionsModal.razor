   KCT QoL (IgnisComeDeliverance): the co-op options as switches, before a session -- the in-game mod menu's own choices. *@
@inherits ModalBase
@using KCDMP_launcher.Models

@if (IsVisible)
{
    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box coop-box" @onclick:stopPropagation="true">
            <div class="modal-frame-top modal-frame-bg"></div>

            <div class="modal-content" style="text-align: left;">
                <div class="modal-title" style="text-align: center;">CO-OP OPTIONS</div>
                <div class="kcd-hint coop-intro">
                    These apply from your next session. You can also change them during play in the mod menu (Insert).
                    The <b>World rules</b> are the host's: they apply to everyone when you host.
                </div>

                <div class="coop-scroll">
                    <div class="coop-group">
                        <div class="coop-group-title">Launching</div>
                        <label class="coop-row">
                            <input type="checkbox" @bind="Settings.AutoConnect" />
                            <span class="coop-text">
                                <span class="coop-label">Connect automatically</span>
                                <span class="kcd-hint">Click Host or Join and you're in. The host connects once their world has loaded;
                                    a joiner with a character joins with it as soon as the host is ready.</span>
                            </span>
                        </label>
                        <label class="coop-row">
                            <input type="checkbox" @bind="Settings.CheckForUpdates" />
                            <span class="coop-text">
                                <span class="coop-label">Check for updates</span>
                                <span class="kcd-hint">When the launcher opens, it looks for a newer IgnisComeDeliverance on GitHub and offers
                                    to install it (checked against the release's checksum first). Both players need the same version.</span>
                            </span>
                        </label>
                    </div>

                    <div class="coop-group">
                        <div class="coop-group-title">Keeping in step (host)</div>
                        <label class="coop-row">
                            <input type="checkbox" @bind="Settings.CatchUpPauseOn" />
                            <span class="coop-text">
                                <span class="coop-label">Pause when my partner falls behind</span>
                                <span class="kcd-hint">When you host and your partner's game falls more than the seconds below behind
                                    yours (a slow PC, or their game in the background), your world pauses until they catch up --
                                    60 seconds at most at a time.</span>
                            </span>
                        </label>
                        <div class="coop-row coop-number @(Settings.CatchUpPauseOn ? "" : "dim")">
                            <span class="coop-text">
                                <span class="coop-label">Seconds behind before pausing</span>
                                <span class="kcd-hint">2 to 60. Lower keeps you closer in step; higher pauses less often.</span>
                            </span>
                            <input class="kcd-input coop-seconds" type="number" min="2" max="60" step="1"
                                   disabled="@(!Settings.CatchUpPauseOn)"
                                   value="@Settings.CatchUpPauseSeconds"
                                   @onchange="e => Settings.CatchUpPauseSeconds = int.TryParse(e.Value?.ToString(), out var s) ? Math.Clamp(s, 2, 60) : 5" />
                        </div>
                    </div>

                    @foreach (var group in CoopOptions.Groups)
                    {
                        <div class="coop-group">
                            <div class="coop-group-title">@group @(group == "World rules" ? " (host)" : "")</div>
                            @foreach (var opt in CoopOptions.All.Where(o => o.Group == group))
                            {
                                var key = opt.Key;
                                <label class="coop-row">
                                    <input type="checkbox" checked="@Values[key]" @onchange="e => Values[key] = e.Value is true" />
                                    <span class="coop-text">
                                        <span class="coop-label">@opt.Label</span>
                                        <span class="kcd-hint">@opt.Help</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="kcd-hint" style="color: var(--kcd-warn);">@Error</div>
                }

                <div class="modal-actions">
                    <button class="kcd-btn primary" @onclick="OnSave">SAVE & CLOSE</button>
                    <button class="kcd-btn" @onclick="ResetDefaults">DEFAULTS</button>
                    <button class="kcd-btn" @onclick="CloseModalAsync">CANCEL</button>
                </div>
            </div>

            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    [Parameter] public AppSettings Settings { get; set; } = new();
    [Parameter] public Dictionary<string, bool> Values { get; set; } = CoopOptions.Read(null);
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private void ResetDefaults()
    {
        foreach (var o in CoopOptions.All) Values[o.Key] = o.Default;
        Settings.AutoConnect = true;
        Settings.CheckForUpdates = true;
        Settings.CatchUpPauseOn = true;
        Settings.CatchUpPauseSeconds = 5;
    }
}
